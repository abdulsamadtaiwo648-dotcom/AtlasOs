<UserControl x:Class="AtlasUI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AtlasUI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="TextToVis"/>
        <local:StringEmptyToVisibilityConverter x:Key="InvTextToVis"/>

        <!-- Pulse used by the voice dot while listening or speaking -->
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.6"/>
        </Storyboard>

        <!-- The status dot: grey when off, accent when waiting, red/amber/green when active -->
        <Style x:Key="VoiceDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="#B8B3A9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Voice.IsIdle}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Voice.IsThinking}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Voice.IsListening}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="ListenPulse" Storyboard="{StaticResource Pulse}"/>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="ListenPulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Voice.IsSpeaking}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="SpeakPulse" Storyboard="{StaticResource Pulse}"/>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpeakPulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuggestionChip" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="14,9"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Grid Grid.Row="0" Margin="32,18,32,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Chat.Title}" Style="{StaticResource PageTitle}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource VoiceDot}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Voice.StatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <Button Style="{StaticResource SoftButton}" Padding="12,6" FontSize="12.5"
                        Command="{Binding Voice.ToggleHandsFreeCommand}">
                    <Button.Content>
                        <TextBlock Text="Hands-free">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Voice.IsHandsFree}" Value="True">
                                            <Setter Property="Text" Value="Hands-free: on"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Messages ================= -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="Scroller_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Chat.Messages}" Margin="32,6,32,16"
                              MaxWidth="860" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,7">
                                <!-- You -->
                                <Border Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Right" MaxWidth="620"
                                        Background="{StaticResource AccentSoftBrush}" CornerRadius="16,16,4,16"
                                        Padding="16,11">
                                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}"/>
                                </Border>

                                <!-- Atlas -->
                                <StackPanel Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}"
                                            HorizontalAlignment="Left" MaxWidth="740">
                                    <TextBlock Text="Atlas" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableText}"/>
                                    <TextBlock Text="Thinking..." Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- Notices and errors -->
                                <Border Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center" Background="#FBEAEA" CornerRadius="10"
                                        Padding="14,8" MaxWidth="620">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource DangerBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Visibility="{Binding Chat.IsEmpty, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,0,32,60">
                <TextBlock Text="What can I help with?" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Type below, click the mic, or turn on hands-free and say the wake word."
                           Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,8,0,22"/>
                <WrapPanel HorizontalAlignment="Center" MaxWidth="620">
                    <Button Content="Remember that my birthday is in May" Style="{StaticResource SuggestionChip}"
                            Command="{Binding Chat.UseSuggestionCommand}"
                            CommandParameter="Remember that my birthday is in May"/>
                    <Button Content="What do you remember about me?" Style="{StaticResource SuggestionChip}"
                            Command="{Binding Chat.UseSuggestionCommand}"
                            CommandParameter="What do you remember about me?"/>
                    <Button Content="Turn on the living room light" Style="{StaticResource SuggestionChip}"
                            Command="{Binding Chat.UseSuggestionCommand}"
                            CommandParameter="Turn on the living room light"/>
                    <Button Content="calculate 18% of 2400" Style="{StaticResource SuggestionChip}"
                            Command="{Binding Chat.UseSuggestionCommand}"
                            CommandParameter="calculate 2400*0.18"/>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- ================= Composer ================= -->
        <StackPanel Grid.Row="2" Margin="32,4,32,18" MaxWidth="860" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource Card}" Padding="14,10,10,10" CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox x:Name="Input" Text="{Binding Chat.InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                                 BorderThickness="0" Background="Transparent" FontSize="14.5"
                                 FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center"
                                 Padding="0,6" PreviewKeyDown="Input_PreviewKeyDown"/>
                        <TextBlock Text="Message Atlas..." Style="{StaticResource Muted}" FontSize="14.5"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0">
                            <TextBlock.Visibility>
                                <Binding Path="Chat.InputText" Converter="{StaticResource InvTextToVis}"/>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="1" Content="&#xE720;" Style="{StaticResource IconButton}" Margin="6,0,2,0"
                            ToolTip="Talk now" Command="{Binding Voice.TalkCommand}"/>

                    <Grid Grid.Column="2">
                        <Button Content="&#xE724;" Style="{StaticResource AccentIconButton}" ToolTip="Send"
                                Command="{Binding Chat.SendCommand}"
                                Visibility="{Binding Chat.IsBusy, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Content="&#xE71A;" Style="{StaticResource AccentIconButton}" ToolTip="Stop"
                                Command="{Binding Chat.StopCommand}"
                                Visibility="{Binding Chat.IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Voice problems (e.g. missing models) -->
            <TextBlock Text="{Binding Voice.Message}" Foreground="{StaticResource DangerBrush}" FontSize="12.5"
                       TextWrapping="Wrap" Margin="6,8,6,0"
                       Visibility="{Binding Voice.Message, Converter={StaticResource TextToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
