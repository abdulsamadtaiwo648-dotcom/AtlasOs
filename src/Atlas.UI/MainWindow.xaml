<Window x:Class="AtlasUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AtlasUI"
        xmlns:views="clr-namespace:AtlasUI.Views"
        Title="Atlas"
        Height="780" Width="1180" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,18">
                    <Ellipse Width="14" Height="14" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Atlas" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0"/>
                </StackPanel>

                <Button Grid.Row="1" Content="New chat" Style="{StaticResource SoftButton}"
                        Command="{Binding Chat.NewChatCommand}" Margin="0,0,0,14"/>

                <!-- Navigation: the selected page gets a white background -->
                <Button Grid.Row="2" Content="Chat" Command="{Binding ShowChatCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChatPage}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Row="3">
                    <Button Content="Memory" Command="{Binding ShowMemoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoryPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Settings" Command="{Binding ShowSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="RECENT CHATS" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"
                               Margin="12,20,0,6"/>
                </StackPanel>

                <!-- Recent chats -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Chat.History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Button Command="{Binding DataContext.Chat.OpenConversationCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource NavButton}" ToolTip="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,26,0" FontSize="13.5"/>
                                    </Button>
                                    <Button HorizontalAlignment="Right" Width="26" Height="26" FontSize="11"
                                            Content="&#xE74D;" ToolTip="Delete this chat"
                                            Style="{StaticResource IconButton}" Margin="0,0,4,0"
                                            Command="{Binding DataContext.Chat.DeleteConversationCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="5" Text="Everything stays on this PC unless you pick a cloud model."
                           Style="{StaticResource Muted}" FontSize="11.5" Margin="6,10,6,0"/>
            </Grid>
        </Border>

        <!-- ================= Pages ================= -->
        <Grid Grid.Column="1">
            <Grid Visibility="{Binding IsChatPage, Converter={StaticResource BoolToVis}}">
                <views:ChatView/>
            </Grid>
            <Grid Visibility="{Binding IsMemoryPage, Converter={StaticResource BoolToVis}}">
                <views:MemoryView DataContext="{Binding Memory}"/>
            </Grid>
            <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
